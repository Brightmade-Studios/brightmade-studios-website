{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://brightmate-worker.brightmadestudios.workers.dev; form-action 'self' https://brightmate-worker.brightmadestudios.workers.dev; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/lab/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/lab",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/assets/pto/hls/*.m3u8",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.apple.mpegurl"
          }
        ]
      },
      {
        "source": "/assets/pto/hls/*.ts",
        "headers": [
          {
            "key": "Content-Type",
            "value": "video/mp2t"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/westhoff-pto/privacy",
        "destination": "https://westhoff-pto.web.app/privacy.html",
        "type": 302
      },
      {
        "source": "/westhoff-pto/delete-account",
        "destination": "https://westhoff-pto.web.app/privacy.html#delete-account",
        "type": 302
      },
      {
        "source": "/westhoff-pto/support",
        "destination": "https://westhoff-pto.web.app/privacy.html#contact",
        "type": 302
      }
    ]
  }
}
