{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/westhoff-pto/privacy",
        "destination": "https://westhoff-pto.web.app/privacy.html",
        "type": 302
      },
      {
        "source": "/westhoff-pto/delete-account",
        "destination": "https://westhoff-pto.web.app/privacy.html#delete-account",
        "type": 302
      },
      {
        "source": "/westhoff-pto/support",
        "destination": "https://westhoff-pto.web.app/privacy.html#contact",
        "type": 302
      },
      {
        "source": "/lab",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/lab/:page*",
        "destination": "/:page",
        "type": 301
      }
    ]
  }
}
